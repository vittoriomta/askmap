{
  "name": "askmap",
  "version": "0.1.0",
  "description": "See what people ask your AI. A private map of your assistant's conversations, drawn on your own machine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "askmap": "bin/askmap.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "analyze": "tsx src/core/cli.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/openai": "^4.0.118",
    "@ai-sdk/openai-compatible": "^3.0.92",
    "@huggingface/transformers": "^4.3.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.173",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "d3-hierarchy": "^3.1.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "keywords": [
    "ai",
    "llm",
    "analytics",
    "privacy",
    "clio",
    "chatgpt",
    "claude",
    "copilot",
    "opentelemetry",
    "local-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vittoriotaucer/askmap"
  },
  "homepage": "https://vittoriotaucer.github.io/projects/askmap/",
  "author": "vittoriomta"
}
